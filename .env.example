# Stable releases use latest; main builds use edge. A version tag or digest can pin a deployment.
CODEX2API_IMAGE=ghcr.io/gucooing/codex2api-rs:latest

# Host folder mapped to /app/data. Create it before starting Compose.
# On Linux the container's UID/GID 10001:10001 must be able to read/write it.
CODEX2API_DATA_DIR=./data

# Host bindings. Keep loopback when a reverse proxy on the host forwards requests.
# Set the relevant HOST to 0.0.0.0 to allow direct access from other machines.
CODEX2API_API_HOST=127.0.0.1
CODEX2API_API_PORT=8080
CODEX2API_ADMIN_HOST=127.0.0.1
CODEX2API_ADMIN_PORT=8081
CODEX2API_USER_HOST=127.0.0.1
CODEX2API_USER_PORT=8082

# Browser/client-facing origins, without /admin, /user or OAuth paths.
# Set these to the actual public origins when changing host ports or using a reverse proxy.
# Addresses saved in the administrator UI take precedence over these startup defaults.
CODEX2API_PUBLIC_API_URL=http://127.0.0.1:8080
CODEX2API_PUBLIC_ADMIN_URL=http://127.0.0.1:8081
CODEX2API_PUBLIC_USER_URL=http://127.0.0.1:8082

RUST_LOG=codex2api=info
