# Stable releases use latest; main builds use edge. A version tag or digest can pin a deployment.
CODEX2API_IMAGE=ghcr.io/gucooing/codex2api-rs:latest

# Required PostgreSQL database. Provision an empty database before first startup.
# The application creates its current schema; it does not apply historical migrations.
CODEX2API_DATABASE_URL=
CODEX2API_DB_MAX_CONNECTIONS=32
CODEX2API_DB_MIN_CONNECTIONS=2
CODEX2API_DB_ACQUIRE_TIMEOUT_SECONDS=10
CODEX2API_DB_IDLE_TIMEOUT_SECONDS=300
CODEX2API_DB_MAX_LIFETIME_SECONDS=1800

# Host bindings. Keep loopback when a reverse proxy on the host forwards requests.
# Set the relevant HOST to 0.0.0.0 to allow direct access from other machines.
CODEX2API_OAUTH_HOST=127.0.0.1
CODEX2API_OAUTH_PORT=8080
CODEX2API_ADMIN_HOST=127.0.0.1
CODEX2API_ADMIN_PORT=8081
CODEX2API_USER_HOST=127.0.0.1
CODEX2API_USER_PORT=8082
CODEX2API_API_HOST=127.0.0.1
CODEX2API_API_PORT=8083

# Browser/client-facing origins, without /admin, /user or OAuth paths.
# Set these to the actual public origins when changing host ports or using a reverse proxy.
# Addresses saved in the administrator UI take precedence over these startup defaults.
CODEX2API_PUBLIC_OAUTH_URL=http://127.0.0.1:8080
CODEX2API_PUBLIC_ADMIN_URL=http://127.0.0.1:8081
CODEX2API_PUBLIC_USER_URL=http://127.0.0.1:8082
CODEX2API_PUBLIC_API_URL=http://127.0.0.1:8083

# Required Redis for session affinity, response ownership, RPM and concurrency leases.
# Set a URL reachable from the application/container before starting.
# Missing configuration or an unavailable Redis prevents startup.
CODEX2API_REDIS_URL=
# Set a unique, stable prefix if this Redis is shared by multiple deployments.
# Empty uses a hash of the PostgreSQL host, port, database and schema.
CODEX2API_REDIS_PREFIX=

RUST_LOG=codex2api=info
