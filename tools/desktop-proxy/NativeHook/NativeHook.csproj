<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Codex2API.NativeHook</AssemblyName>
    <BaseOutputPath>../../../target/desktop-proxy/native-bin/</BaseOutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../NativeProcess.cs" Link="NativeProcess.cs" />
    <Compile Include="../CommandLine.cs" Link="CommandLine.cs" />
  </ItemGroup>
</Project>
