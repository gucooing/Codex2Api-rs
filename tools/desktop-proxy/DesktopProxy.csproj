<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Codex2API.DesktopProxy</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BaseOutputPath>../../target/desktop-proxy/bin/</BaseOutputPath>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <HookRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</HookRuntimeIdentifier>
    <HookRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</HookRuntimeIdentifier>
    <NativeHookOutput>$(MSBuildThisFileDirectory)../../target/desktop-proxy/native-publish/$(HookRuntimeIdentifier)/</NativeHookOutput>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="NativeHook/**/*.cs" />
    <Compile Include="NativeHook/AddressPolicy.cs" />
    <EmbeddedResource Include="$(NativeHookOutput)Codex2API.NativeHook.dll" LogicalName="NativeHook" />
  </ItemGroup>
  <Target Name="BuildNativeHook" BeforeTargets="PrepareResourceNames">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)NativeHook/NativeHook.csproj&quot; -c $(Configuration) -r $(HookRuntimeIdentifier) -o &quot;$(NativeHookOutput)&quot;" StdOutEncoding="utf-8" StdErrEncoding="utf-8" />
  </Target>
</Project>
